{
  "name": "carpet-grand-prix",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "build:race-preview": "node scripts/build-race-preview.js",
    "build:offline": "node scripts/build-offline.js",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:all": "npm test && npm run test:browser",
    "test:reference": "vitest run tests/integration/reference.test.js",
    "test:extended": "vitest run --config vitest.extended.config.js",
    "serve:test": "node tests/helpers/server.js",
    "fixtures:generate": "node tests/helpers/generate-fixtures.js",
    "build:pilot-art": "node scripts/build-pilot-art.js",
    "build:pilot-preview": "node scripts/build-pilot-preview.js",
    "build:world-review": "node scripts/build-world-review.js",
    "build:uploaded-portraits": "node scripts/build-uploaded-portraits.js",
    "build:arcade-data": "node scripts/export-arcade-data.js",
    "build:arcade-offline": "node scripts/build-arcade-offline.js",
    "build:arcade3d-engine": "node scripts/build-arcade3d-engine.js",
    "check:arcade3d-engine": "node scripts/build-arcade3d-engine.js --check",
    "measure:arcade3d": "node scripts/measure-arcade3d.js",
    "build:arcade-boundaries": "node scripts/build-arcade-boundaries.js",
    "check:arcade-boundaries": "node scripts/build-arcade-boundaries.js --check"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0",
    "polygon-clipping": "0.15.7",
    "rolldown": "1.2.16",
    "three": "0.187.0",
    "vitest": "5.1.0"
  }
}
